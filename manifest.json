{
  "manifest_version": 3,
  "name": "E-game 積木工具（精簡版）",
  "description": "積木 XML 複製貼上與分批加速執行，可暫停或繼續。",
  "version": "1.1.0",
  "permissions": [
    "clipboardRead"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.egame.kh.edu.tw/auth/dotCode/apps/dojo/",
        "https://*.egame.kh.edu.tw/auth/dotCode/apps/duck/play"
      ],
      "include_globs": [
        "*play",
        "*edit"
      ],
      "js": [
        "turtle-speedup.js",
        "copy-paste.js"
      ],
      "css": [
        "copy-paste.css"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
